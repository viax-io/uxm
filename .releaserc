{
  "branches": ["master"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", {
      "changelogFile": "CHANGELOG.md"
    }],
    ["@semantic-release/exec", {
      "prepareCmd": "node scripts/stamp-skill-version.mjs ${nextRelease.version}"
    }],
    "@semantic-release/npm",
    ["@semantic-release/gitlab", {
      "gitlabUrl": "https://gitlab.viax.tech/",
      "assets": [
        { "path": "CHANGELOG.md", "label": "CHANGELOG" },
        { "path": "package.json", "label": "package.json" },
        { "path": "package-lock.json", "label": "package-lock.json" }
      ]
    }],
    ["@semantic-release/git", {
      "assets": [
        "CHANGELOG.md",
        "package.json",
        "package-lock.json",
        "skills/viax-uxm/SKILL.md",
        "skills/viax-uxm/references/component-catalog.md"
      ],
      "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
    }]
  ]
}
