{
  "name": "@viax/uxm",
  "version": "2.6.0",
  "description": "Viax UXM — React 19 UI primitives and design tokens.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "require": "./dist/ui/index.cjs"
    },
    "./ui.css": "./dist/ui/styles.css",
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js",
      "require": "./dist/tokens/index.cjs"
    },
    "./tokens.css": "./dist/tokens/index.css",
    "./previews": {
      "types": "./dist/previews/index.d.ts",
      "import": "./dist/previews/index.js",
      "require": "./dist/previews/index.cjs"
    },
    "./studio": {
      "types": "./dist/studio/index.d.ts",
      "import": "./dist/studio/index.js",
      "require": "./dist/studio/index.cjs"
    },
    "./studio/generate-css": {
      "types": "./dist/studio/persistence/generate-css.d.ts",
      "import": "./dist/studio/persistence/generate-css.js",
      "require": "./dist/studio/persistence/generate-css.cjs"
    },
    "./studio.css": "./dist/studio/studio.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup && npm run build:studio-css && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.json --outDir dist --resolve-full-paths",
    "build:studio-css": "tailwindcss -i ./src/studio/studio.css -o ./dist/studio/studio.css --minify",
    "build:modo": "vite build -c portal/vite.config.ts",
    "dev": "tsup --watch",
    "dev:modo": "vite -c portal/vite.config.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:ci": "echo 'no tests yet' && exit 0",
    "test:coverage": "echo 'no coverage yet' && exit 0",
    "commit": "cz",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix"
    ]
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^9.39.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/gitlab": "^13.3.2",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/cli": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "sass": "^1.100.0",
    "semantic-release": "^25.0.3",
    "tailwindcss": "^4.0.0",
    "tsc-alias": "^1.8.17",
    "tsup": "^8.3.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.60.0",
    "vite": "^5.4.0"
  },
  "publishConfig": {
    "registry": "https://nexus.viax.tech/repository/npm-private/"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.viax.tech/services-viax/uxm.git"
  },
  "engines": {
    "node": ">=20"
  }
}
